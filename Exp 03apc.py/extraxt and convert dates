import re
from datetime import datetime

text = input("Enter text containing dates: ")

pattern = r"\d{2}/\d{2}/\d{4}|\d{2}-\d{2}-\d{4}|\d{4}\.\d{2}\.\d{2}|[A-Za-z]+ \d{1,2}, \d{4}"

dates = re.findall(pattern, text)

for date in dates:
    try:
        if "/" in date:
            result = datetime.strptime(date, "%d/%m/%Y")
        elif "-" in date:
            result = datetime.strptime(date, "%m-%d-%Y")
        elif "." in date:
            result = datetime.strptime(date, "%Y.%m.%d")
        else:
            result = datetime.strptime(date, "%B %d, %Y")

        print(result.strftime("%Y-%m-%d"))
    except ValueError:
        print("Invalid date:", date)